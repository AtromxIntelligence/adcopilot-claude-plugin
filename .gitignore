# OS
.DS_Store
Thumbs.db

# Local client state — never part of the plugin
*.local.json

# Local evaluation output and replay caches — never part of the plugin
evals/results/
.replay/

# Python's compiled files — never part of the plugin. A plugin install copies
# the repository, and a .pyc records the path of the machine it was compiled on.
__pycache__/
*.pyc
*.py[cod]
